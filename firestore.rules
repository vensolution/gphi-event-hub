rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hrDoc() { return /databases/$(database)/documents/config/hr; }
    function hrExists() { return exists(hrDoc()); }
    function isHR() { return signedIn() && hrExists() && get(hrDoc()).data.uid == request.auth.uid; }
    function dirDoc(uid) { return get(/databases/$(database)/documents/directory/$(uid)).data; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/directory/$(request.auth.uid)) && dirDoc(request.auth.uid).status == 'active'; }

    // each person's own saved forms
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // the person HR assigned to approve inventory stock out (config/inv)
    function isApprover() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/inv)
        && (get(/databases/$(database)/documents/config/inv).data.get('approverUid', '') == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/config/inv).data.get('approverUids', []));
    }

    // the ONE central HR account (can never be changed from the website)
    match /config/hr {
      allow get: if true;
      allow create: if signedIn() && !hrExists()
        && request.resource.data.uid == request.auth.uid
        && dirDoc(request.auth.uid).requestedRole == 'hr';
      allow update, delete: if false;
    }

    // account records: people create their own as "pending", only HR can approve
    match /directory/{uid} {
      // colleagues can look up other ACTIVE people (to pick them on the OB form)
      allow get: if signedIn() && (request.auth.uid == uid || isHR()
        || (resource.data.status == 'active' && dirDoc(request.auth.uid).status == 'active'));
      allow list: if isHR()
        || (signedIn() && resource.data.status == 'active' && dirDoc(request.auth.uid).status == 'active');
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'employee'
        && request.resource.data.requestedRole in ['employee', 'hr'];
      // HR can change anything; a person can only change their own contact details and photo (name and work details need HR approval)
      allow update: if isHR()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'address', 'emerg', 'birthday', 'photo', 'updatedAt']));
      allow delete: if false;
    }

    // department structure: who the Direct manager and Admin are (HR sets this)
    match /depts/{id} {
      allow read: if signedIn();
      allow write: if isHR();
    }

    // approval requests: Direct manager -> Admin -> HR
    match /requests/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.current == 0
        && dirDoc(request.auth.uid).status == 'active'
        && dirDoc(request.auth.uid).deptId == request.resource.data.deptId
        && request.resource.data.chain.size() == 3
        && request.resource.data.chain[0].uid == get(/databases/$(database)/documents/depts/$(request.resource.data.deptId)).data.manager
        && request.resource.data.chain[1].uid == get(/databases/$(database)/documents/depts/$(request.resource.data.deptId)).data.admin
        && request.resource.data.chain[2].uid == get(hrDoc()).data.uid;
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.viewers);
      allow update: if signedIn() && resource.data.status == 'pending' && (
        (request.auth.uid == resource.data.chain[resource.data.current].uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chain', 'current', 'status']))
        || (request.auth.uid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled'));
    }

    // colleague consent: you can only add a colleague to your OB form after they accept
    match /tags/{id} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && dirDoc(request.auth.uid).status == 'active'
        && dirDoc(request.resource.data.toUid).status == 'active';
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.status == 'pending' && (
        (request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.status in ['accepted', 'declined'])
        || (request.auth.uid == resource.data.fromUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled'));
    }

    // inventory: any approved employee can read and encode; only HR can delete an item
    match /stock_items/{id} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.qty >= 0
        && request.resource.data.totalIn >= 0;
      // lowering the quantity (stock out) is only for the approver (or HR)
      allow update: if isActive()
        && request.resource.data.qty >= 0
        && request.resource.data.totalIn >= 0
        && (request.resource.data.qty >= resource.data.qty || isApprover() || isHR());
      allow delete: if isHR();
    }
    match /stock_moves/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.by == request.auth.uid
        && (request.resource.data.type != 'out' || isApprover() || isHR());
      allow update, delete: if false;
    }

    // assets / links: everyone approved can read, add and edit links (edit history is kept in each record); only HR can delete
    match /asset_links/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow update: if isActive() && request.resource.data.by == resource.data.by
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameKey', 'url', 'updatedAt', 'updatedBy', 'updatedByName', 'history']);
      allow delete: if isHR();
    }

    // stock out requests: any approved employee requests, the assigned approver (or HR) decides
    match /stock_requests/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isActive() && (resource.data.by == request.auth.uid || isApprover() || isHR());
      allow update: if isActive() && (isApprover() || isHR()
        || (resource.data.by == request.auth.uid && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'));
      allow delete: if isHR();
    }
    // returns after a cancelled event: the requester sends, any approver (or HR) confirms that the items were received
    match /stock_returns/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isActive() && (resource.data.by == request.auth.uid || isApprover() || isHR());
      allow update: if isActive() && (isApprover() || isHR());
      allow delete: if isHR();
    }
    match /config/inv {
      allow read: if isActive();
      allow write: if isHR();
    }

    // website logo: everyone can read it (also on the sign-in page), only HR can change it
    match /config/brand {
      allow get: if true;
      allow write: if isHR();
    }

    // requests to change name / work details: the person sends, HR decides
    match /profile_requests/{id} {
      allow create: if isActive() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isActive() && (resource.data.uid == request.auth.uid || isHR());
      allow update: if isHR();
      allow delete: if isHR() || (isActive() && resource.data.uid == request.auth.uid && resource.data.status == 'pending');
    }

    // who opened / copied each Assets/Links link (written by the person who opens it; read by HR and the person who encoded the link)
    match /asset_views/{id} {
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow read: if isHR() || (isActive() && resource.data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if isHR();
    }

    // liquidation reports: each person manages their own; HR can see and manage all
    match /liquidations/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isActive() && (resource.data.by == request.auth.uid || isHR());
      allow update: if isActive() && (resource.data.by == request.auth.uid || isHR()) && request.resource.data.by == resource.data.by;
      allow delete: if isActive() && (resource.data.by == request.auth.uid || isHR());
    }

    // liquidation done from inside Event Games (one per event, separate from the Liquidation module): every approved employee can see it, the person who made it (or HR) can edit it
    match /event_liquidations/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isActive();
      allow update: if isActive() && (resource.data.by == request.auth.uid || isHR()) && request.resource.data.by == resource.data.by;
      allow delete: if isActive() && (resource.data.by == request.auth.uid || isHR());
    }

    // team schedule: everyone approved can read; the person who encoded it (or HR) can edit or delete
    match /schedules/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow update: if isActive() && (resource.data.by == request.auth.uid || isHR())
        && request.resource.data.by == resource.data.by;
      allow delete: if isActive() && (resource.data.by == request.auth.uid || isHR());
    }
  }
}
